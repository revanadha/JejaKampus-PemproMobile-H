  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "node test-api.js"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironment": "node",
    "testMatch": [
