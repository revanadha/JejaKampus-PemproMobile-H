    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "node test-api.js"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
